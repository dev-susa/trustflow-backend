{
  "name": "trustflow-backend",
  "version": "1.0.0",
  "description": "Node.js API for TrustFlow off-chain data.",
  "main": "dist/main.js",
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "lint:check": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "export:openapi": "ts-node scripts/export-openapi.ts",
    "check:cycles": "madge --circular --extensions ts src",
    "backup:postgres": "bash scripts/backup-postgres.sh",
    "backup:redis": "bash scripts/backup-redis.sh",
    "restore:postgres": "bash scripts/restore-postgres.sh",
    "restore:redis": "bash scripts/restore-redis.sh"
  },
  "dependencies": {
    "@apollo/server": "^4.13.0",
    "@nestjs/apollo": "^12.2.2",
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/graphql": "^12.2.2",
    "@nestjs/jwt": "^10.0.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/swagger": "^7.0.0",
    "@nestjs/terminus": "^10.3.0",
    "@sentry/node": "^8.55.2",
    "@stellar/stellar-sdk": "^12.0.0",
    "arweave": "^1.15.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "opossum": "^8.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "redis": "^6.3.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "zod": "^3.22.0"
  },
  "optionalDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.50.0",
    "@opentelemetry/core": "^1.26.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.53.0",
    "@opentelemetry/resources": "^1.26.0",
    "@opentelemetry/sdk-node": "^0.53.0",
    "@opentelemetry/sdk-trace-base": "^1.26.0",
    "@opentelemetry/semantic-conventions": "^1.27.0"
  },
  "overrides": {
    "axios": "^1.20.0",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/opossum": "^8.1.9",
    "@types/passport-jwt": "^4.0.0",
    "@types/stellar-sdk": "^0.11.1",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "madge": "^8.0.0",
    "prettier": "^3.0.0",
    "supertest": "^6.3.0",
    "ts-jest": "^29.1.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.1.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*[.-]spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/*.spec.ts",
      "!**/*-spec.ts",
      "!**/*.module.ts",
      "!**/index.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "coverageThreshold": {
      "global": {
        "branches": 30,
        "functions": 35,
        "lines": 40,
        "statements": 40
      },
      "./escrow/": {
        "branches": 50,
        "functions": 60,
        "lines": 60,
        "statements": 60
      },
      "./dispute/": {
        "branches": 50,
        "functions": 60,
        "lines": 60,
        "statements": 60
      },
      "./auth/": {
        "branches": 50,
        "functions": 60,
        "lines": 60,
        "statements": 60
      },
      "./gig/": {
        "branches": 50,
        "functions": 60,
        "lines": 60,
        "statements": 60
      },
      "./outbox/": {
        "branches": 50,
        "functions": 60,
        "lines": 60,
        "statements": 60
      },
      "./common/rate-limit/": {
        "branches": 50,
        "functions": 60,
        "lines": 60,
        "statements": 60
      },
      "./common/idempotency/": {
        "branches": 50,
        "functions": 60,
        "lines": 60,
        "statements": 60
      }
    }
  }
}
