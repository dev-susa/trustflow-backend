          },
          {
            "description": "Number of items to skip. Defaults to 0.",
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "type": "number",
            },
          },
          {
            "description": "Maximum number of items to return (max 100). Defaults to 20.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "type": "number",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "items": {
                        "properties": {
                          "amountXLM": {
                            "type": "string",
                          },
                          "beneficiary": {
                            "type": "string",
                          },
                          "createdAt": {
                            "format": "date-time",
                            "type": "string",
                          },
                          "depositor": {
                            "type": "string",
                          },
                          "id": {
                            "type": "string",
                          },
                          "status": {
                            "type": "string",
                          },
                        },
                        "type": "object",
                      },
                      "type": "array",
                    },
                    "total": {
                      "type": "number",
                    },
                  },
                  "type": "object",
                },
              },
            },
            "description": "Paginated list of escrows",
          },
        },
        "summary": "Get escrows by depositor",
        "tags": [
          "Escrow",
        ],
      },
    },
