    "/ipfs/pins": {
      "get": {
        "operationId": "IpfsPinningController_findAll",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/PinRecordResponseDto",
