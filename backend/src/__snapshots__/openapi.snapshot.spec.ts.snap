    "/gigs": {
      "get": {
        "description": "Paginated search over gig solicitations, defaulting to open (unaccepted) gigs sorted newest first. Results are cached in Redis for GIG_SEARCH_CACHE_TTL_SECONDS (default 30s) to reduce load on repeated queries; any gig mutation invalidates the cache immediately.",
        "operationId": "GigController_search",
        "parameters": [
          {
            "description": "Maximum budget in XLM.",
            "in": "query",
            "name": "maxBudgetXLM",
            "required": false,
            "schema": {
              "type": "string",
            },
          },
          {
            "description": "Minimum budget in XLM.",
            "in": "query",
            "name": "minBudgetXLM",
            "required": false,
            "schema": {
              "type": "string",
            },
          },
          {
            "description": "Results per page, up to 100. Defaults to 20.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "type": "number",
            },
          },
          {
            "description": "Page number (1-indexed). Defaults to 1.",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "type": "number",
            },
          },
          {
            "description": "Filter by gig status. Defaults to "open".",
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "enum": [
                "open",
                "accepted",
                "expired",
                "cancelled",
              ],
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "items": {
                      "items": {
                        "type": "object",
                      },
                      "type": "array",
                    },
                    "limit": {
                      "type": "number",
                    },
                    "page": {
                      "type": "number",
                    },
                    "total": {
                      "type": "number",
                    },
                  },
                  "type": "object",
                },
              },
            },
            "description": "Paginated gig solicitations",
          },
        },
        "summary": "Search gig solicitations",
        "tags": [
          "Gigs",
        ],
      },
      "post": {
        "description": "Creates an open gig solicitation. If nobody accepts it within the response window (default 72h), the background expiry sweep automatically marks it as expired.",
        "operationId": "GigController_create",
        "parameters": [
          {
            "description": "A unique key (e.g. UUID) to ensure this request is idempotent. Retries with the same key and body return the original response without creating a duplicate. Reusing the key with a different body returns 422.",
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "budgetXLM": {
                    "description": "Budget in XLM",
                    "example": "250",
                    "type": "string",
                  },
                  "creator": {
                    "description": "Stellar address of the gig creator",
                    "example": "GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX",
                    "type": "string",
                  },
                  "responseWindowHours": {
                    "description": "Hours to wait for a response before expiring. Defaults to 72.",
                    "example": 72,
                    "type": "number",
                  },
                  "title": {
                    "example": "Build a Soroban escrow audit report",
                    "type": "string",
                  },
                },
                "required": [
                  "creator",
                  "title",
                  "budgetXLM",
                ],
                "type": "object",
              },
            },
          },
          "description": "Gig solicitation details",
          "required": true,
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "budgetXLM": {
                      "type": "string",
                    },
                    "createdAt": {
                      "format": "date-time",
                      "type": "string",
                    },
                    "creator": {
                      "type": "string",
                    },
                    "id": {
                      "example": "gig-1234567890-ab12cd",
                      "type": "string",
                    },
                    "respondBy": {
                      "format": "date-time",
                      "type": "string",
                    },
                    "status": {
                      "enum": [
                        "open",
                        "accepted",
                        "expired",
                        "cancelled",
                      ],
                      "type": "string",
                    },
                    "title": {
                      "type": "string",
                    },
                  },
                  "type": "object",
                },
              },
            },
            "description": "Gig solicitation created",
          },
        },
        "security": [
          {
            "JWT-auth": [],
          },
        ],
        "summary": "Post a gig solicitation",
        "tags": [
          "Gigs",
        ],
      },
    },
    "/gigs/creator/{address}": {
      "get": {
        "description": "Retrieves gig solicitations by a creator with optional filtering and pagination.",
        "operationId": "GigController_findByCreator",
