        ],
      },
    },
    "/ipfs/pins/{cid}/verify": {
      "post": {
        "description": "Re-checks every provider believed to hold the pin and, if replication has dropped below the configured factor, attempts to restore it via any remaining providers. The re-pin worker calls this same logic automatically on a schedule; this endpoint triggers it on demand.",
        "operationId": "IpfsPinningController_verify",
        "parameters": [
          {
            "in": "path",
            "name": "cid",
            "required": true,
            "schema": {
              "example": "bafkreihdwdcefgh4dqkjv67uzcmw7ojee6xedzdetojuzjevtenxquvyku",
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PinRecordResponseDto",
                },
              },
            },
            "description": "",
          },
          "404": {
            "description": "Pin record not found",
          },
        },
        "security": [
          {
            "JWT-auth": [],
          },
        ],
        "summary": "Re-verify pin durability and top up replication if degraded",
        "tags": [
          "IPFS Pinning",
        ],
      },
    },
