          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "avatarUrl": {
                    "type": "string",
                  },
                  "bio": {
                    "maxLength": 500,
                    "type": "string",
                  },
                  "email": {
                    "type": "string",
                  },
                  "name": {
                    "maxLength": 100,
                    "minLength": 2,
                    "type": "string",
                  },
                  "skills": {
                    "items": {
                      "type": "string",
                    },
                    "type": "array",
                  },
                  "socialLinks": {
                    "type": "object",
                  },
                  "status": {
                    "enum": [
                      "active",
                      "inactive",
                      "suspended",
                    ],
                    "type": "string",
                  },
                  "userType": {
                    "enum": [
                      "freelancer",
                      "client",
                      "both",
                    ],
                    "type": "string",
                  },
                },
                "type": "object",
              },
            },
          },
          "description": "Profile update fields",
          "required": true,
        },
        "responses": {
          "200": {
            "description": "Profile updated successfully. The email address is only included when the caller owns the profile.",
          },
          "401": {
            "description": "Unauthorized",
          },
          "404": {
            "description": "Profile not found",
          },
        },
        "security": [
          {
            "bearer": [],
          },
        ],
        "summary": "Update user profile",
        "tags": [
          "User Profiles",
        ],
      },
    },
    "/profiles/{id}/avatar": {
      "post": {
        "description": "Uploads a profile picture to S3-compatible storage and updates the user profile. Accepts JPEG, PNG, or WebP images up to 5MB.",
