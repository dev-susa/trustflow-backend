              },
            },
          },
          "required": true,
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DisputeSagaResponseDto",
                },
              },
            },
            "description": "",
          },
          "400": {
            "description": "No verdict or saga not at PAYOUT step",
          },
        },
        "security": [
          {
            "JWT-auth": [],
          },
        ],
        "summary": "Step 4 — Execute payout",
        "tags": [
          "Dispute Resolution",
        ],
      },
    },
    "/dispute/{sagaId}/vote": {
      "post": {
        "description": "Records a vote from an assigned juror. When all jurors have voted, the verdict is computed automatically via majority rule and the saga advances to the PAYOUT step. Compensating action: removes the vote if an error occurs mid-recording.",
        "operationId": "DisputeSagaController_castVote",
        "parameters": [
          {
            "in": "path",
            "name": "sagaId",
            "required": true,
            "schema": {
              "example": "saga-1234567890-abc",
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CastVoteDto",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DisputeSagaResponseDto",
                },
              },
            },
            "description": "",
          },
          "400": {
            "description": "Juror not assigned or saga not at VOTING step",
          },
          "409": {
            "description": "Juror has already voted",
          },
        },
        "security": [
          {
            "JWT-auth": [],
          },
        ],
        "summary": "Step 3 — Cast a juror vote",
        "tags": [
          "Dispute Resolution",
        ],
      },
    },
