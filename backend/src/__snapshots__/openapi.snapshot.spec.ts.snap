    "/reputation/leaderboard": {
      "get": {
        "description": "Sorted by score descending; ties are broken by eventCount descending, then address ascending, so the ordering is fully deterministic and stable across requests. \`limit\` caps the number of entries returned (top-N only — there is no offset/cursor, since this is a ranking view rather than a paged listing). Unauthenticated: like the escrow read endpoints, this reflects publicly derivable on-chain/dispute history rather than private data, and cannot be written to directly.",
        "operationId": "ReputationController_getLeaderboard",
        "parameters": [
          {
            "description": "Maximum number of top-ranked entries to return. Falls back to 50 if omitted or not a positive number.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "example": 50,
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ReputationScoreResponseDto",
                  },
                  "type": "array",
                },
              },
            },
            "description": "",
          },
        },
        "summary": "List addresses ranked by trust score, highest first",
        "tags": [
          "Reputation",
        ],
      },
    },
    "/reputation/{address}": {
      "get": {
        "description": "Score is derived from escrow completion and dispute-resolution history. Repeated interactions with the same counterparty are dampened with diminishing returns to resist wash-trading and self-dealing, and the score exponentially decays toward zero without new activity. Unauthenticated by design: the score is derived data a caller cannot set directly, not a private value, so it is safe and intended to be publicly checkable like the escrow read endpoints.",
        "operationId": "ReputationController_getScore",
        "parameters": [
          {
            "in": "path",
            "name": "address",
            "required": true,
            "schema": {
              "example": "GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX",
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReputationScoreResponseDto",
                },
              },
            },
            "description": "",
          },
        },
        "summary": "Get the time-decayed, Sybil-dampened trust score for an address",
        "tags": [
          "Reputation",
        ],
      },
    },
    "/rpc-status": {
      "get": {
        "description": "Returns the health status of all configured Horizon and Soroban RPC endpoints, including which endpoint is currently active.",
        "operationId": "RpcStatusController_getStatus",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "currentHorizonEndpoint": "https://horizon-testnet.stellar.org",
                    "currentSorobanEndpoint": "https://soroban-testnet.stellar.org",
                    "horizonEndpoints": [
                      {
                        "failureCount": 0,
                        "healthy": true,
                        "lastChecked": "2024-01-01T00:00:00.000Z",
                        "url": "https://horizon-testnet.stellar.org",
                      },
                    ],
                    "sorobanEndpoints": [
                      {
                        "failureCount": 0,
                        "healthy": true,
                        "lastChecked": "2024-01-01T00:00:00.000Z",
                        "url": "https://soroban-testnet.stellar.org",
                      },
                    ],
                    "timestamp": "2024-01-01T00:00:00.000Z",
                  },
                },
              },
            },
            "description": "RPC endpoint status information",
          },
          "401": {
            "description": "Missing or invalid JWT",
          },
        },
        "security": [
          {
            "JWT-auth": [],
          },
        ],
        "summary": "Get current RPC endpoint status and health information",
        "tags": [
          "RPC Status",
        ],
      },
    },
    "/stellar/balance/{address}": {
      "get": {
        "operationId": "StellarController_getBalance",
        "parameters": [
          {
            "description": "Stellar account public key (G… strkey)",
