                      "format": "uuid",
                      "type": "string",
                    },
                    "isVerified": {
                      "example": false,
                      "type": "boolean",
                    },
                    "lastActiveAt": {
                      "format": "date-time",
                      "nullable": true,
                      "type": "string",
                    },
                    "name": {
                      "type": "string",
                    },
                    "rating": {
                      "example": 0,
                      "type": "number",
                    },
                    "ratingCount": {
                      "example": 0,
                      "type": "number",
                    },
                    "skills": {
                      "items": {
                        "type": "string",
                      },
                      "nullable": true,
                      "type": "array",
                    },
                    "socialLinks": {
                      "nullable": true,
                      "type": "object",
                    },
                    "status": {
                      "enum": [
                        "active",
                        "inactive",
                        "suspended",
                      ],
                      "type": "string",
                    },
                    "totalEarned": {
                      "example": "0",
                      "type": "string",
                    },
                    "totalSpent": {
                      "example": "0",
                      "type": "string",
                    },
                    "updatedAt": {
                      "format": "date-time",
                      "type": "string",
                    },
                    "userType": {
                      "enum": [
                        "freelancer",
                        "client",
                        "both",
                      ],
                      "type": "string",
                    },
                    "walletAddress": {
                      "type": "string",
                    },
                  },
                  "type": "object",
                },
              },
            },
            "description": "Profile details",
          },
          "404": {
            "description": "Profile not found",
          },
        },
        "summary": "Get profile by ID",
        "tags": [
          "User Profiles",
        ],
      },
      "put": {
        "description": "Updates an existing user profile. Requires authentication.",
        "operationId": "UserProfileController_update",
        "parameters": [
          {
            "description": "Profile ID",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
