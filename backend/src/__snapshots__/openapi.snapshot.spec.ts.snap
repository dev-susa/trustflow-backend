                  "type": "array",
                },
              },
            },
            "description": "",
          },
        },
        "security": [
          {
            "JWT-auth": [],
          },
        ],
        "summary": "List all pin records",
        "tags": [
          "IPFS Pinning",
        ],
      },
      "post": {
        "description": "Computes the CIDv1 content hash of the supplied bytes and pins them to providers in priority order until \`replicationFactor\` providers succeed, automatically failing over to the next provider whenever one fails to pin or fails post-pin verification.",
        "operationId": "IpfsPinningController_pin",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PinContentDto",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PinRecordResponseDto",
                },
              },
            },
            "description": "",
          },
          "400": {
            "description": "expectedCid does not match the computed content hash",
          },
          "503": {
            "description": "Every registered provider failed to pin the content",
          },
        },
        "security": [
          {
            "JWT-auth": [],
          },
        ],
        "summary": "Pin a deliverable across multiple IPFS providers",
        "tags": [
          "IPFS Pinning",
        ],
      },
    },
    "/ipfs/pins/{cid}": {
      "delete": {
        "description": "The record only becomes \`UNPINNED\` (and \`ipfs.pin.removed\` only fires) once every provider has released the pin. If a provider fails, the record moves to \`UNPINNING\`, that provider stays \`PINNED\` with \`lastError\` set, and a 502 lists the per-provider results. Repeat the request to retry only the providers that still hold the pin.",
        "operationId": "IpfsPinningController_unpin",
        "parameters": [
          {
            "in": "path",
            "name": "cid",
            "required": true,
            "schema": {
              "example": "bafkreihdwdcefgh4dqkjv67uzcmw7ojee6xedzdetojuzjevtenxquvyku",
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PinRecordResponseDto",
                },
              },
            },
            "description": "",
          },
          "404": {
            "description": "Pin record not found",
          },
          "502": {
            "description": "At least one provider failed to release the pin; the response body carries the per-provider results",
          },
        },
        "security": [
          {
            "JWT-auth": [],
          },
        ],
        "summary": "Unpin content from every provider currently holding it",
        "tags": [
          "IPFS Pinning",
        ],
      },
      "get": {
        "operationId": "IpfsPinningController_findOne",
        "parameters": [
          {
            "in": "path",
            "name": "cid",
            "required": true,
            "schema": {
              "example": "bafkreihdwdcefgh4dqkjv67uzcmw7ojee6xedzdetojuzjevtenxquvyku",
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PinRecordResponseDto",
