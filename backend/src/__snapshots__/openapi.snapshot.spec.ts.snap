    "/escrows/{id}/dispute": {
      "post": {
        "description": "Raises a dispute for an escrow. Triggers webhook events and Discord notifications to alert jurors.",
        "operationId": "EscrowController_raiseDispute",
        "parameters": [
          {
            "description": "Escrow ID",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "example": "esc-1234567890",
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "reason": {
                    "description": "Reason for the dispute",
                    "example": "Work not delivered as specified",
                    "type": "string",
                  },
                },
                "type": "object",
              },
            },
          },
          "description": "Dispute details",
          "required": true,
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "disputeReason": {
                      "type": "string",
                    },
                    "disputedAt": {
                      "format": "date-time",
                      "type": "string",
                    },
                    "id": {
                      "type": "string",
                    },
                    "status": {
                      "example": "disputed",
                      "type": "string",
                    },
                  },
                  "type": "object",
                },
              },
            },
            "description": "Dispute raised successfully. Discord notification sent if configured.",
          },
          "400": {
            "description": "Escrow already disputed or released",
          },
          "404": {
            "description": "Escrow not found",
          },
        },
        "summary": "Raise a dispute",
        "tags": [
          "Escrow",
        ],
      },
    },
    "/escrows/{id}/release": {
      "post": {
        "description": "Approves a milestone tranche and releases funds to the beneficiary.",
        "operationId": "EscrowController_release",
        "parameters": [
          {
            "description": "Escrow ID",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "example": "esc-1234567890",
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "description": "Escrow released successfully",
          },
          "404": {
            "description": "Escrow not found",
          },
        },
        "summary": "Release escrow funds",
        "tags": [
          "Escrow",
        ],
      },
    },
    "/escrows/{id}/release/transaction": {
      "get": {
        "description": "Builds and simulates a Soroban \`release\` invocation for a chain-linked escrow. The backend never holds a signing key for this — see the #180 write-path spike write-up. Client flow: (1) call this endpoint to get unsigned XDR, (2) sign it locally with the sourceAccount wallet, (3) submit the signed envelope directly to Soroban RPC — the resulting chain event flows back into this API through the existing event-ingestion pipeline. Requires TRUSTFLOW_CONTRACT_ID to be configured and the escrow to be linked to an on-chain ID.",
        "operationId": "EscrowController_buildReleaseTransaction",
        "parameters": [
          {
            "description": "Escrow ID",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "example": "esc-1234567890",
              "type": "string",
            },
          },
          {
            "description": "Stellar address that will sign and submit the transaction",
            "in": "query",
            "name": "sourceAccount",
            "required": true,
            "schema": {
              "example": "GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX",
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "contractId": {
                      "example": "CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX",
                      "type": "string",
                    },
                    "network": {
                      "example": "TESTNET",
                      "type": "string",
                    },
                    "networkPassphrase": {
                      "example": "Test SDF Network ; September 2015",
                      "type": "string",
                    },
                    "sourceAccount": {
                      "example": "GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX",
                      "type": "string",
                    },
                    "xdr": {
                      "example": "AAAAAgAAAAA...",
                      "type": "string",
                    },
                  },
                  "type": "object",
                },
              },
            },
            "description": "Unsigned release transaction XDR, ready for the caller to sign and submit",
          },
          "400": {
            "description": "Invalid or missing sourceAccount",
          },
          "404": {
            "description": "Escrow not found or not linked to an on-chain escrow",
          },
          "503": {
            "description": "TRUSTFLOW_CONTRACT_ID is not configured",
          },
        },
        "summary": "Build an unsigned on-chain release transaction (prototype, spike #180)",
        "tags": [
          "Escrow",
        ],
      },
    },
