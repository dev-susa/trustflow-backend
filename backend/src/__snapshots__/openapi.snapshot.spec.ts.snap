    "/auth/challenge": {
      "get": {
        "description": "Generates a single-use, time-limited challenge message for wallet signature. The challenge nonce is stored server-side with a 60-second TTL and is enforceably single-use. In multi-node deployments, nonces are stored in Redis for distributed replay protection.",
        "operationId": "AuthController_getChallenge",
        "parameters": [
          {
            "description": "Stellar wallet address (G... public key)",
            "in": "query",
            "name": "address",
            "required": true,
            "schema": {
              "example": "GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX",
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChallengeResponseDto",
                },
              },
            },
            "description": "Challenge generated successfully (valid for 60 seconds)",
          },
          "400": {
            "description": "Invalid Stellar address format",
          },
        },
        "summary": "Get authentication challenge",
        "tags": [
          "Authentication",
        ],
      },
    },
    "/auth/verify": {
      "post": {
        "description": "Verifies the Stellar wallet-signed challenge and returns a JWT token. The challenge nonce is consumed atomically (single-use) and replay attempts are blocked. Each nonce is only valid for 60 seconds after generation.",
        "operationId": "AuthController_verify",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyDto",
              },
            },
          },
          "description": "Signature verification details",
          "required": true,
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponseDto",
                },
              },
            },
            "description": "Signature verified, JWT token generated",
          },
          "401": {
            "description": "Invalid signature, expired challenge, or replay attempt blocked",
          },
        },
        "summary": "Verify wallet signature",
        "tags": [
          "Authentication",
        ],
      },
    },
    "/deliverables": {
      "post": {
        "description": "Only the freelancer who accepted the gig can upload for it: the gig must exist, be accepted, and \`freelancer\` must be both the gig's accepted freelancer and the authenticated wallet. \`content\` must be valid base64 of at most 10 MB decoded.",
        "operationId": "DeliverableController_upload",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "content": {
                    "description": "Base64-encoded file content (at most 10 MB decoded)",
                    "maxLength": 14316560,
                    "type": "string",
                  },
                  "filename": {
                    "example": "audit-report.pdf",
                    "type": "string",
                  },
                  "freelancer": {
                    "example": "GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX",
                    "type": "string",
                  },
                  "gigId": {
                    "example": "gig-1234567890-ab12cd",
                    "type": "string",
                  },
                },
                "required": [
                  "gigId",
                  "freelancer",
                  "content",
                  "filename",
                ],
                "type": "object",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "201": {
            "description": "Deliverable uploaded and pinned",
          },
          "400": {
            "description": "Invalid payload, or content is not valid base64 / exceeds the size limit",
          },
          "403": {
            "description": "Gig was not accepted by both the given freelancer and the authenticated wallet",
          },
          "404": {
            "description": "Gig not found",
          },
          "409": {
            "description": "Gig has not been accepted",
          },
          "503": {
            "description": "IPFS pinning failed",
          },
        },
        "security": [
          {
            "JWT-auth": [],
          },
        ],
        "summary": "Upload a deliverable and pin to IPFS",
        "tags": [
          "Deliverables",
        ],
      },
    },
