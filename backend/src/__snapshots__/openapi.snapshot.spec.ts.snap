    "/migrations/runs/{runId}/rollback": {
      "post": {
        "description": "Invokes the rollbackContract/rollbackExpand compensating actions on demand.",
        "operationId": "MigrationController_rollback",
        "parameters": [
          {
            "in": "path",
            "name": "runId",
            "required": true,
            "schema": {
              "example": "mig-1234567890-abcd1234",
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MigrationRunResponseDto",
                },
              },
            },
            "description": "",
          },
          "400": {
            "description": "Run already rolled back",
          },
          "403": {
            "description": "Caller is authenticated but not an admin address",
          },
          "409": {
            "description": "Run still in progress",
          },
        },
        "security": [
          {
            "JWT-auth": [],
          },
        ],
        "summary": "Manually roll back a completed or failed migration run",
        "tags": [
          "Schema Migrations",
        ],
      },
    },
    "/migrations/{name}/run": {
      "post": {
        "description": "Runs the named migration end to end in small batches so the target table is never locked. If any phase fails, compensating actions automatically roll back the expand/contract changes.",
        "operationId": "MigrationController_run",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "example": "gigs-add-priority-column",
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunMigrationDto",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MigrationRunResponseDto",
                },
              },
            },
            "description": "",
          },
          "403": {
            "description": "Caller is authenticated but not an admin address",
          },
          "404": {
            "description": "Migration not registered",
          },
          "409": {
            "description": "Migration already has an active run",
          },
        },
        "security": [
          {
            "JWT-auth": [],
          },
        ],
        "summary": "Execute an expand → backfill → contract migration",
        "tags": [
          "Schema Migrations",
        ],
      },
    },
