            "description": "",
          },
        },
        "summary": "Latest closed ledger sequence",
        "tags": [
          "Stellar",
        ],
      },
    },
    "/webhooks": {
      "post": {
        "description": "Register a webhook endpoint to receive event notifications. Supported events: escrow.created, escrow.released, dispute.raised, dispute.resolved.",
        "operationId": "WebhookController_register",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "events": {
                    "description": "List of events to subscribe to (defaults to ["*"])",
                    "example": [
                      "escrow.created",
                      "escrow.released",
                    ],
                    "items": {
                      "type": "string",
                    },
                    "type": "array",
                  },
                  "id": {
                    "description": "Unique identifier for this webhook",
                    "example": "my-webhook-1",
                    "type": "string",
                  },
                  "secret": {
                    "description": "Optional HMAC secret (min 16 characters) used to sign outgoing webhook payloads via the X-TrustFlow-Signature header",
                    "example": "your-16-plus-character-secret",
                    "minLength": 16,
                    "type": "string",
                  },
                  "url": {
                    "description": "HTTPS endpoint to receive webhook POST requests",
                    "example": "https://example.com/webhooks/trustflow",
                    "format": "uri",
                    "type": "string",
                  },
                },
                "required": [
                  "id",
                  "url",
                ],
                "type": "object",
              },
            },
          },
          "description": "Webhook registration details",
          "required": true,
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "id": {
                      "example": "my-webhook-1",
                      "type": "string",
                    },
                    "registered": {
                      "example": true,
                      "type": "boolean",
                    },
                  },
                  "type": "object",
                },
              },
            },
            "description": "Webhook registered successfully",
          },
          "400": {
            "description": "Invalid webhook URL, ID, or secret",
          },
        },
        "summary": "Register webhook",
        "tags": [
          "Webhooks",
        ],
      },
    },
    "/webhooks/{id}": {
      "delete": {
        "description": "Remove a previously registered webhook by its ID.",
        "operationId": "WebhookController_unregister",
        "parameters": [
          {
            "description": "Webhook ID",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "example": "my-webhook-1",
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "unregistered": {
                      "example": true,
                      "type": "boolean",
                    },
                  },
                  "type": "object",
                },
              },
            },
            "description": "Webhook unregistered successfully",
          },
          "404": {
            "description": "Webhook not found",
          },
        },
        "summary": "Unregister webhook",
        "tags": [
          "Webhooks",
        ],
      },
    },
  },
  "servers": [
    {
      "description": "Development",
      "url": "http://localhost:3001",
      "variables": undefined,
    },
    {
      "description": "Production",
      "url": "https://api.trustflow.xyz",
      "variables": undefined,
    },
  ],
  "tags": [
    {
      "description": "Wallet-based JWT authentication endpoints",
      "name": "Authentication",
    },
    {
      "description": "Escrow vault management and dispute resolution. Note: these endpoints are currently unauthenticated — rate limiting is IP-scoped only.",
      "name": "Escrow",
    },
    {
      "description": "Webhook registration and management. Note: register/unregister endpoints are currently unauthenticated — rate limiting is IP-scoped only.",
      "name": "Webhooks",
    },
    {
      "description": "Durable at-least-once domain event delivery and relay operations",
      "name": "Outbox",
    },
    {
      "description": "Health checks and metrics",
      "name": "Monitoring",
    },
    {
      "description": "Multi-provider IPFS pinning with content-hash verification, automatic failover, and a background re-pin worker that restores replication when a provider silently drops a pin.",
      "name": "IPFS Pinning",
    },
    {
      "description": "Gig solicitation postings with a background sweep that automatically expires solicitations left unanswered past their response deadline.",
      "name": "Gigs",
    },
    {
      "description": "Read-only system analytics for protocol admins — escrow, gig, dispute, reputation, migration, and reconciliation state aggregated into a dashboard view. Restricted to wallet addresses listed in \`ADMIN_ADDRESSES\`.",
      "name": "Admin",
    },
  ],
}
`;
