        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "address": "GA7Q…",
                    "balance": "99.5000000",
                  },
                },
              },
            },
            "description": "",
          },
          "400": {
            "description": "Malformed Stellar address",
          },
          "404": {
            "description": "Account not found on the network (unfunded or nonexistent)",
          },
        },
        "summary": "Native XLM balance for a Stellar account",
        "tags": [
          "Stellar",
        ],
      },
    },
