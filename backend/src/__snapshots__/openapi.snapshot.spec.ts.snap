    "/profiles": {
      "get": {
        "description": "Retrieves all user profiles with optional filtering and pagination. Email addresses are never included.",
        "operationId": "UserProfileController_findAll",
        "parameters": [
          {
            "description": "Filter by user type",
            "in": "query",
            "name": "userType",
            "required": false,
            "schema": {
              "enum": [
                "freelancer",
                "client",
                "both",
              ],
              "type": "string",
            },
          },
          {
            "description": "Filter by status",
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "enum": [
                "active",
                "inactive",
                "suspended",
              ],
              "type": "string",
            },
          },
          {
            "description": "Minimum rating filter",
            "in": "query",
            "name": "minRating",
            "required": false,
            "schema": {
              "type": "number",
            },
          },
          {
            "description": "Number of items to skip. Defaults to 0.",
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "type": "number",
            },
          },
          {
            "description": "Maximum number of items to return (max 100). Defaults to 20.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "type": "number",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "items": {
                        "properties": {
                          "completedJobs": {
                            "type": "number",
                          },
                          "id": {
                            "type": "string",
                          },
                          "isVerified": {
                            "type": "boolean",
                          },
                          "name": {
                            "type": "string",
                          },
                          "rating": {
                            "type": "number",
                          },
                          "userType": {
                            "type": "string",
                          },
                          "walletAddress": {
                            "type": "string",
                          },
                        },
                        "type": "object",
                      },
                      "type": "array",
                    },
                    "total": {
                      "type": "number",
                    },
                  },
                  "type": "object",
                },
              },
            },
            "description": "Paginated list of user profiles",
          },
        },
        "summary": "Get all user profiles",
        "tags": [
          "User Profiles",
        ],
      },
      "post": {
        "description": "Creates a new user profile for a freelancer or client. Requires authentication; \`walletAddress\` must match the wallet address on the authenticated JWT — you can only create a profile for the wallet you signed in with, not on behalf of another address.",
        "operationId": "UserProfileController_create",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "avatarUrl": {
                    "description": "Profile image URL",
                    "example": "https://example.com/avatar.jpg",
                    "type": "string",
                  },
                  "bio": {
                    "description": "User biography",
                    "example": "Experienced blockchain developer with 5+ years in Web3",
                    "maxLength": 500,
                    "type": "string",
                  },
                  "email": {
                    "description": "Email address (optional)",
                    "example": "john@example.com",
                    "type": "string",
                  },
                  "name": {
                    "description": "User display name",
                    "example": "John Doe",
                    "maxLength": 100,
                    "minLength": 2,
                    "type": "string",
                  },
                  "skills": {
                    "description": "List of skills (for freelancers)",
                    "example": [
                      "Solidity",
                      "Rust",
                      "TypeScript",
                      "Smart Contracts",
                    ],
                    "items": {
                      "type": "string",
                    },
                    "maxItems": 20,
                    "type": "array",
                  },
                  "socialLinks": {
                    "properties": {
                      "github": {
                        "example": "https://github.com/johndoe",
                        "type": "string",
                      },
                      "linkedin": {
                        "example": "https://linkedin.com/in/johndoe",
                        "type": "string",
                      },
                      "twitter": {
                        "example": "https://twitter.com/johndoe",
                        "type": "string",
                      },
                      "website": {
                        "example": "https://johndoe.dev",
                        "type": "string",
                      },
                    },
                    "type": "object",
                  },
                  "userType": {
                    "description": "Type of user account",
                    "enum": [
                      "freelancer",
                      "client",
                      "both",
                    ],
                    "example": "freelancer",
                    "type": "string",
                  },
                  "walletAddress": {
                    "description": "Stellar wallet address (G-prefixed, 56 characters)",
                    "example": "GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX",
                    "type": "string",
                  },
                },
                "required": [
                  "walletAddress",
                  "name",
                  "userType",
                ],
                "type": "object",
              },
            },
          },
          "description": "User profile creation details",
          "required": true,
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "avatarUrl": {
                      "nullable": true,
                      "type": "string",
                    },
                    "bio": {
                      "nullable": true,
                      "type": "string",
                    },
                    "completedJobs": {
                      "example": 0,
                      "type": "number",
                    },
                    "createdAt": {
                      "format": "date-time",
                      "type": "string",
                    },
                    "email": {
                      "nullable": true,
                      "type": "string",
                    },
                    "id": {
                      "format": "uuid",
                      "type": "string",
                    },
                    "isVerified": {
                      "example": false,
                      "type": "boolean",
                    },
                    "lastActiveAt": {
                      "format": "date-time",
                      "nullable": true,
                      "type": "string",
                    },
                    "name": {
                      "type": "string",
                    },
                    "rating": {
                      "example": 0,
                      "type": "number",
                    },
                    "ratingCount": {
                      "example": 0,
                      "type": "number",
                    },
                    "skills": {
                      "items": {
                        "type": "string",
                      },
                      "nullable": true,
                      "type": "array",
                    },
                    "socialLinks": {
                      "nullable": true,
                      "type": "object",
                    },
                    "status": {
                      "enum": [
                        "active",
                        "inactive",
                        "suspended",
                      ],
                      "type": "string",
                    },
                    "totalEarned": {
                      "example": "0",
                      "type": "string",
                    },
                    "totalSpent": {
                      "example": "0",
                      "type": "string",
                    },
                    "updatedAt": {
                      "format": "date-time",
                      "type": "string",
                    },
                    "userType": {
                      "enum": [
                        "freelancer",
                        "client",
                        "both",
                      ],
                      "type": "string",
                    },
                    "walletAddress": {
                      "type": "string",
                    },
                  },
                  "type": "object",
                },
              },
            },
            "description": "Profile created successfully",
          },
          "400": {
            "description": "Invalid input data",
          },
          "401": {
            "description": "Unauthorized",
          },
          "403": {
            "description": "walletAddress does not match the authenticated wallet",
          },
          "409": {
            "description": "Profile with this wallet address already exists",
          },
        },
        "security": [
          {
            "bearer": [],
          },
        ],
        "summary": "Create a new user profile",
        "tags": [
          "User Profiles",
        ],
      },
    },
